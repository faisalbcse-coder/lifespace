# SQLite Database file path
# For production deployments, specify a persistent durable volume path
# e.g., DATABASE_URL="file:/var/data/pms.db"
DATABASE_URL="file:./dev.db"

# Secret key used for signing session tokens (must be at least 32 characters in production)
# Generate with: openssl rand -base64 32
JWT_SECRET="replace-with-a-secure-random-32-char-string-in-production"

# Node Environment ("development" | "production" | "test")
NODE_ENV="development"

# Email / SMTP Configuration (Optional, defaults to local mail relay)
SMTP_HOST="127.0.0.1"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="noreply@lifespace.notekori.com"
SMTP_PASS="your-email-password"
SMTP_FROM="LifeSpace <noreply@lifespace.notekori.com>"
APP_URL="https://lifespace.notekori.com"

